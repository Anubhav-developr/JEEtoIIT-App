{
  "expo": {
    "name": "Saumya JEE 2027",
    "slug": "saumya-jee-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.saumyajee.portal",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B1020"
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Saumya JEE 2027 to select a profile photo.",
          "cameraPermission": "Allow Saumya JEE 2027 to take a profile photo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
